# ============================================================
# 生产环境变量清单(cp .env.example .env 后填写;.env 已在 .gitignore)
# ============================================================

# 数据库
KA_DB_USER=ka
KA_DB_PASSWORD=

# JWT 密钥:openssl rand -base64 48
KA_JWT_SECRET=

# 卡密/渠道配置加密主密钥(AES-256):openssl rand -base64 32
# !!! 妥善备份:丢失后已加密卡密无法解密 !!!
KA_AES_KEY=

# 加密货币商户收款地址(冷钱包地址,服务器不持有私钥)
KA_MERCHANT_ADDRESS=

# 初始管理员密码(仅首次启动生效;不设置则随机生成并打印在日志中)
KA_ADMIN_INIT_PASSWORD=
